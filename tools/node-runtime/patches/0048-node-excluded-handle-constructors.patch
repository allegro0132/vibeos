 void StatWatcher::New(const FunctionCallbackInfo<Value>& args) {
   CHECK(args.IsConstructCall());
+#if defined(__vibeos__)
+  auto* isolate = args.GetIsolate();
+  auto error = v8::Exception::Error(v8::String::NewFromUtf8Literal(
+      isolate, "VibeOS does not support file polling")).As<v8::Object>();
+  error->Set(isolate->GetCurrentContext(),
+      v8::String::NewFromUtf8Literal(isolate, "code"),
+      v8::String::NewFromUtf8Literal(isolate, "ERR_VIBEOS_UNSUPPORTED")).Check();
+  isolate->ThrowException(error);
+  return;
+#endif
   fs::BindingData* binding_data = Realm::GetBindingData<fs::BindingData>(args);
   new StatWatcher(binding_data, args.This(), args[0]->IsTrue());
 }
