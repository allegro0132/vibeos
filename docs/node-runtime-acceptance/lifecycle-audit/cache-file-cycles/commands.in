quiet
@sleep 0.3
mkdir @home/project
@sleep 0.3
echo 'export default value => value + 1;' | write @home/project/helper.mjs
@sleep 0.3
echo 'const fs = require("fs"), id = Number(process.argv[process.argv.length-1]); let input = "";' | write @home/project/cycle.cjs
@sleep 0.3
echo 'process.stdin.setEncoding("utf8"); process.stdin.on("data", data => input += data);' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'process.stdin.on("end", async () => {' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'const previous = fs.existsSync("counter") ? Number(fs.readFileSync("counter","utf8")) : 0;' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'if (previous+1 !== id || input.trim() !== "payload") throw Error("cycle sequence/stdin");' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'fs.writeFileSync("counter", String(id)); fs.openSync("counter", "r");' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'if (await fs.promises.readFile("counter","utf8") !== String(id)) throw Error("async file");' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'const module = await import("./helper.mjs"); if(module.default(41)!==42) throw Error("module import");' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'await new Promise(resolve => setTimeout(resolve,1));' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'const buffer = Buffer.alloc(65536, id); if(buffer[65535] !== id) throw Error("buffer");' | write --append @home/project/cycle.cjs
@sleep 0.3
echo 'console.log("NODE_CYCLE_" + "OK=" + id); });' | write --append @home/project/cycle.cjs
@sleep 0.3
@send echo payload | node --root @home/project cycle.cjs 1
@sleep 0.3
@expect NODE_CYCLE_OK=1
@sleep 0.3
@expect NATIVE PAGE RECLAIM live_bytes=0 live_allocations=0 owner_registered=0
@sleep 0.3
@send vtop --once
@sleep 0.3
@expect --: awaiting interval sample.
@sleep 0.3
@send echo payload | node --root @home/project cycle.cjs 2
@sleep 0.3
@expect NODE_CYCLE_OK=2
@sleep 0.3
@expect NATIVE PAGE RECLAIM live_bytes=0 live_allocations=0 owner_registered=0
