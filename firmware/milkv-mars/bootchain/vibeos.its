/dts-v1/;
/ {
    description = "VibeOS Mars 4GB serial and SD bring-up";
    #address-cells = <2>;
    images {
        kernel {
            data = /incbin/("vibeos.bin");
            type = "kernel";
            arch = "riscv";
            // Selects the RISC-V a0=hart, a1=DTB handoff in bootm.
            os = "linux";
            compression = "none";
            load = <0 0x40200000>;
            entry = <0 0x40200000>;
            hash-1 { algo = "sha256"; };
        };
        fdt {
            data = /incbin/("mars.dtb");
            type = "flat_dt";
            arch = "riscv";
            compression = "none";
            hash-1 { algo = "sha256"; };
        };
    };
    configurations {
        default = "mars-4gb";
        mars-4gb { kernel = "kernel"; fdt = "fdt"; };
    };
};
