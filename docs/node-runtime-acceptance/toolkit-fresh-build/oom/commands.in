quiet
@sleep 0.3
mkdir @home/project
@sleep 0.3
echo 'console.log("NODE_OOM_" + "READY");' | write @home/project/oom.cjs
@sleep 0.3
echo 'setTimeout(() => { const retained = []; for (;;) retained.push(new Array(1048576).fill(1)); }, 20);' | write --append @home/project/oom.cjs
@sleep 0.3
@send node --root @home/project oom.cjs
@sleep 0.3
@expect NODE_OOM_READY
@sleep 0.3
@expect NATIVE FATAL EXIT
@sleep 0.3
@wait-exit
