+/* VibeOS types for the bundled libuv port. No POSIX syscall implementation.
+ * Socket address layouts permit upstream public declarations and pure address
+ * conversion; actual network, process and terminal operations remain unsupported.
+ */
+#ifndef UV_VIBEOS_H
+#define UV_VIBEOS_H
+
+#include <stdint.h>
+#include <sys/types.h>
+
+#define UV_ONCE_INIT {0}
+typedef struct { unsigned state; } uv_once_t;
+typedef uintptr_t uv_thread_t;
+typedef struct { void* semaphore; } uv_mutex_t;
+typedef struct { void* semaphore; } uv_rwlock_t;
+typedef struct { void* semaphore; } uv_sem_t;
+typedef struct { uint64_t generation; } uv_cond_t;
+typedef struct { uintptr_t slot; } uv_key_t;
+struct _uv_barrier {
+  uv_mutex_t mutex;
+  uv_cond_t cond;
+  unsigned threshold;
+  unsigned in;
+  unsigned out;
+};
+typedef struct { struct _uv_barrier* b; } uv_barrier_t;
+
+/* No ambient directory iterator is exposed by the native runtime. */
+typedef struct vibeos_uv_dir DIR;
+/* Owned records for the capability-backed scandir implementation. */
+struct dirent { unsigned char d_type; char d_name[]; };
+struct addrinfo;
+
+typedef uint16_t sa_family_t;
+struct sockaddr { sa_family_t sa_family; char sa_data[14]; };
+struct sockaddr_storage {
+  sa_family_t ss_family;
+  unsigned char padding[118];
+  uint64_t alignment;
+};
+struct in_addr { uint32_t s_addr; };
+struct in6_addr { unsigned char s6_addr[16]; };
+struct sockaddr_in {
+  sa_family_t sin_family;
+  uint16_t sin_port;
+  struct in_addr sin_addr;
+  unsigned char sin_zero[8];
+};
+struct sockaddr_in6 {
+  sa_family_t sin6_family;
+  uint16_t sin6_port;
+  uint32_t sin6_flowinfo;
+  struct in6_addr sin6_addr;
+  uint32_t sin6_scope_id;
+};
+static inline uint16_t htons(uint16_t value) {
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+  return __builtin_bswap16(value);
+#else
+  return value;
+#endif
+}
+
+#define AF_UNSPEC 0
+#define AF_INET 2
+#define AF_INET6 10
+#define INET_ADDRSTRLEN 16
+#define INET6_ADDRSTRLEN 46
+
+#endif
