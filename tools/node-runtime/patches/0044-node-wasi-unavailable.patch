--- a/src/node_wasi.cc
+++ b/src/node_wasi.cc
@@ -1,3 +1,22 @@
+#if defined(__vibeos__)
+#include "node_binding.h"
+#include "v8.h"
+namespace node::wasi {
+// V8 WebAssembly is disabled. The esbuild transform service runs through
+// VibeOS's independent WASI executor, not through this Node binding.
+void InitializePreview1(v8::Local<v8::Object>, v8::Local<v8::Value>,
+                        v8::Local<v8::Context> context, void*) {
+  auto* isolate = context->GetIsolate();
+  auto error = v8::Exception::Error(v8::String::NewFromUtf8Literal(
+      isolate, "Node WASI requires WebAssembly, disabled in the VibeOS Node port"));
+  error.As<v8::Object>()->Set(context,
+      v8::String::NewFromUtf8Literal(isolate, "code"),
+      v8::String::NewFromUtf8Literal(isolate, "ERR_VIBEOS_UNSUPPORTED")).Check();
+  isolate->ThrowException(error);
+}
+}  // namespace node::wasi
+NODE_BINDING_CONTEXT_AWARE_INTERNAL(wasi, node::wasi::InitializePreview1)
+#else
 #include "node_wasi.h"
 #include "base_object-inl.h"
 #include "debug_utils-inl.h"
@@ -1362,3 +1381,5 @@
 }  // namespace node
 
