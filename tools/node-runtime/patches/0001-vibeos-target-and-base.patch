+Semaphore::Semaphore(int count) {
+  CHECK_GE(count, 0);
+  native_handle_ = vibeos_native_semaphore_create(count);
+  CHECK_NOT_NULL(native_handle_);
+}
+Semaphore::~Semaphore() {
+  vibeos_native_semaphore_destroy(native_handle_);
+}
+void Semaphore::Signal() {
+  CHECK_EQ(0, vibeos_native_semaphore_signal(native_handle_));
+}
+void Semaphore::Wait() {
+  CHECK_EQ(1, vibeos_native_semaphore_wait(native_handle_, -1));
+}
+bool Semaphore::WaitFor(const TimeDelta& rel_time) {
+  const int64_t timeout = rel_time.InMicroseconds();
+  const int result = vibeos_native_semaphore_wait(native_handle_, timeout > 0 ? timeout : 0);
+  CHECK_GE(result, 0);
+  return result == 1;
+}
