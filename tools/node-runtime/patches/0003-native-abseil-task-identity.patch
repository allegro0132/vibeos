+  const int64_t micros = vibeos_native_monotonic_us();
+  ABSL_RAW_CHECK(micros >= 0 && micros <= INT64_MAX / 1000,
+                 "VibeOS monotonic clock failed or overflowed");
+  return micros * 1000;
+#else
   if (!SupportsSteadyClock()) {
     return absl::GetCurrentTimeNanos();
   }
   return std::chrono::duration_cast<std::chrono::nanoseconds>(
              std::chrono::steady_clock::now().time_since_epoch())
       .count();
+#endif
 }
 
